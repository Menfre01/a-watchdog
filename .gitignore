# 构建产物
bin/
dist/
# go build 未指定 -o 时在仓库根落下的二进制(锚定根,不影响 cmd/awatchdog/)
/awatchdog
# 控制台前端产物:仅保留占位文件入库(go:embed 要求目录非空)
!pkg/admin/dist/
pkg/admin/dist/*
!pkg/admin/dist/placeholder.txt

# 前端依赖与缓存
node_modules/
.pnpm-store/
.vite/
.turbo/
.cache/
*.tsbuildinfo
.eslintcache
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Python(scripts/ 辅助脚本的字节码缓存)
__pycache__/
*.pyc

# 运行时数据文件(SQLite;--data-dir 指到仓库内时产生)
.awatchdog/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 日志与临时文件
*.log
logs/
tmp/
temp/
*.tmp

# 本地密钥与证书
.secrets/
*.key
*.pem
*.p12
*.pfx

# Waveloom(本地配置/日志/会话)
.waveloom/

# Claude Code(本地命令与 skills)
.claude/

# DeepSeek Harness(本地 skills,软链到 .claude/skills)
.dsh/

# gstack(本地工具目录)
.gstack/

