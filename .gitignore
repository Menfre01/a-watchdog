# 本地配置与密钥
.env
.env.*
!.env.example

# macOS
.DS_Store

# Go
coverage.out
*.test
*.out

# 构建产物
bin/
dist/
# go build 未指定 -o 时在仓库根落下的二进制(锚定根,不影响 cmd/awatchdog/)
/awatchdog
# 控制台前端产物:仅保留占位文件入库(go:embed 要求目录非空)
!pkg/admin/dist/
pkg/admin/dist/*
!pkg/admin/dist/placeholder.txt

# 前端依赖(如有)
node_modules/
# pnpm 本地包缓存(可能落在仓库根,约数十 MB)
.pnpm-store/

# Python(scripts/ 辅助脚本的字节码缓存)
__pycache__/
*.pyc

# 运行时数据文件(SQLite;--data-dir 指到仓库内时产生)
*.db
*.db-wal
*.db-shm

# IDE
.vscode/
.idea/

# Waveloom(本地配置/日志/会话)
.waveloom/

# Claude Code(本地命令与 skills)
.claude/

# DeepSeek Harness(本地 skills,软链到 .claude/skills)
.dsh/

# gstack(本地工具目录)
.gstack/

# 注:OpenSpec 规范是唯一事实源,提案与归档一并入库,故不设忽略规则。
