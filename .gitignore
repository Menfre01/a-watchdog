# 本地配置与密钥
.env
.env.*
!.env.example

# macOS
.DS_Store

# Go
coverage.out
*.test
*.out

# 构建产物
bin/
dist/
# go build 未指定 -o 时在仓库根落下的二进制(锚定根,不影响 cmd/ds-context/)
/ds-context
# 控制台前端产物:仅保留占位文件入库(go:embed 要求目录非空)
!pkg/admin/dist/
pkg/admin/dist/*
!pkg/admin/dist/placeholder.txt

# 前端依赖(如有)
node_modules/
# pnpm 本地包缓存(可能落在仓库根,约数十 MB)
.pnpm-store/

# 运行时数据文件(SQLite;--data-dir 指到仓库内时产生)
*.db
*.db-wal
*.db-shm

# IDE
.vscode/
.idea/

# Waveloom(本地配置/日志/会话)
.waveloom/

# Claude Code(本地命令与 skills)
.claude/

# OpenSpec(本地变更提案与 specs,不入仓库)
openspec/
